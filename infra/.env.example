PROJECT_NAME=ai-nutribot
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
ALLOWED_HOSTS=backend,localhost,127.0.0.1,caloiq.ru
DJANGO_CORS_ORIGINS=https://caloiq.ru,http://localhost:5173
TIME_DEFAULT_TZ=Europe/Moscow
POSTGRES_DB=nutribot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0

# Backend configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_PROVIDER_TOKEN=telegram-provider-token
PAYMENT_PROVIDER_TOKEN=
WALLET_PRICE_GENERATE_PLAN_STARS=120
WALLET_PRICE_GENERATE_PLAN_TITLE=AI план питания
WALLET_PRICE_GENERATE_PLAN_DESCRIPTION=Генерация индивидуального плана
TELEGRAM_MT_API_ID=0
TELEGRAM_MT_API_HASH=your-telegram-api-hash
TELEGRAM_MT_SESSION=
TELEGRAM_MT_BOT_TOKEN=
TELEGRAM_MT_TEST_MODE=0
STARS_RECONCILE_ENABLED=0
STARS_RECONCILE_EMAILS=
SLACK_STARS_ALERT_WEBHOOK=
# Keep JWT_SECRET stable between deployments to avoid invalidating issued tokens
JWT_SECRET=please-generate-a-64-byte-secret

# Bot configuration
BOT_TOKEN=your-telegram-bot-token
# Используется ботом для общения с бэкендом.
# В docker-compose контейнер "bot" не видит хостовый localhost, поэтому
# оставляем адрес сервиса backend во внутренней сети Compose.
BACKEND_URL=http://backend:8000
CLOUDPUB_TOKEN=
WEBAPP_URL=https://caloiq.ru
# Дополнительные хосты для Vite dev server (через запятую или перевод строки)
DEV_SERVER_ALLOWED_HOSTS=
BOT_SESSION_TTL_HOURS=24

# LLM (optional)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DEFAULT_CITY=Москва
DEFAULT_CURRENCY=RUB


BOT_INTERNAL_KEY=please-set-bot-internal-key
FEED_INGESTION_RETRY_ATTEMPTS=3
FEED_INGESTION_INTERVAL_MINUTES=15
FEED_INGESTION_ALERT_EMAILS=ops@example.com,dev@example.com
FEED_INGESTION_ALERT_WEBHOOK=https://hooks.example.com/feed-ingestion
FEED_TRANSLATE_RU_ENABLED=1
MARKET_TRANSLATE_RU_ENABLED=0
TRANSLATE_TARGET_LANG=ru
TRANSLATE_PROVIDERS=yandex
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id


FEED_INGESTION_SOURCES=[{"name":"harvard-nutrition-source","url":"https://nutritionsource.hsph.harvard.edu/feed/","categories":["healthy_food","nutrition","global"],"timeout":10,"enabled":true},{"name":"bon-appetit","url":"https://www.bonappetit.com/feed/rss","categories":["recipes","tasty","lifestyle"],"timeout":10,"enabled":true},{"name":"epicurious","url":"https://www.epicurious.com/feed/recipes/rss","categories":["recipes","tasty"],"timeout":10,"enabled":true},{"name":"guardian-food","url":"https://www.theguardian.com/food/rss","categories":["europe","policy","food"],"timeout":10,"enabled":true},{"name":"food52-blog","url":"https://food52.com/blog.rss","categories":["recipes","healthy_food"],"timeout":10,"enabled":true},{"name":"serious-eats","url":"https://www.seriouseats.com/rss","categories":["recipes","technique"],"timeout":10,"enabled":true},{"name":"fao-newsroom","url":"https://www.fao.org/feeds/fao-newsroom-rss","categories":["global","food_safety","policy"],"timeout":10,"enabled":true},{"name":"efsa-news","url":"https://www.efsa.europa.eu/en/news/rss","categories":["food_safety","europe"],"timeout":10,"enabled":true},{"name":"anses-actualites","url":"https://www.anses.fr/en/rss","categories":["food_safety","france"],"timeout":10,"enabled":true},{"name":"lebensmittelwarnung-hessen","url":"https://www.lebensmittelwarnung.de/bvl-lmw-de/opensaga/feed/alle/hessen.rss","categories":["food_safety","germany"],"timeout":10,"enabled":true},{"name":"foodsafetynews","url":"https://www.foodsafetynews.com/feed/","categories":["food_safety","global","news"],"timeout":10,"enabled":true},{"name":"euractiv-agrifood","url":"https://www.euractiv.com/section/agriculture-food/feed/","categories":["europe","policy","nutrition"],"timeout":10,"enabled":true},{"name":"cfs-hongkong-whatsnew","url":"https://www.cfs.gov.hk/english/whatsnew/whatsnew_rss.xml","categories":["asia","food_safety"],"timeout":10,"enabled":true},{"name":"fsanz-news","url":"https://www.foodstandards.gov.au/rss/news.xml","categories":["australia","new_zealand","food_safety"],"timeout":10,"enabled":true},{"name":"foodsafety-gov-recalls","url":"https://www.foodsafety.gov/recalls/rss","categories":["usa","food_safety"],"timeout":10,"enabled":true},{"name":"who-news","url":"https://www.who.int/api/news/newsitems","categories":["global","health","policy"],"timeout":15,"enabled":true,"params":{"pageSize":"50","language":"en"},"parser":{"blueprint":"who-news"}}]
